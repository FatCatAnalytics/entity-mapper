{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Entity Mapper",
  "version": "1.0.0",
  "identifier": "com.entitymapper.desktop",
  "build": {
    "frontendDist": "../desktop/splash",
    "beforeBuildCommand": "npm run build:web && npm run build:engine"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Entity Mapper",
        "width": 1280,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../dist-engine/engine/": "engine/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
